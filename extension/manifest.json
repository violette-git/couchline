{
  "manifest_version": 3,
  "name": "Couchline for Netflix and Hulu",
  "short_name": "Couchline",
  "version": "0.1.0",
  "description": "Watch Netflix and Hulu in sync with your Couchline room, with the room's video call and reactions beside the show.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_title": "Couchline",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content/netflix-page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.netflix.com/*", "https://www.hulu.com/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidebar/*", "lib/*"],
      "matches": ["https://www.netflix.com/*", "https://www.hulu.com/*"]
    }
  ]
}
