# Optional TURN relay so calls connect on strict networks (cell data, work Wi-Fi).
# Get credentials from a TURN provider (Metered, Cloudflare Calls, Twilio) or run coturn.
TURN_URLS=turn:your-turn-host:3478,turns:your-turn-host:5349
TURN_USERNAME=
TURN_CREDENTIAL=

# Twitch only plays inside sites it's told about. List the domain (or domains) people open
# Couchline on, comma separated, with no https:// or port. Defaults to localhost.
TWITCH_PARENT=couchline-yourname.herokuapp.com,localhost

# Optional: turns on YouTube search inside Couchline. A free YouTube Data API v3 key from
# Google Cloud (see README). Without it, people paste links or use the other ways to add.
YOUTUBE_API_KEY=
